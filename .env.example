# Copy this file to `.env` and fill in your own values.
# Leave everything blank to run fully offline (mock LLM) for a demo.

# --- LLM (Groq free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
# Pick any current Groq chat model (run `python -m app.list_models` to see yours):
LLM_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3
LLM_TEMPERATURE=0.2
# Force the offline rule-based agent even if a key is set:
USE_MOCK_LLM=0

# --- WhatsApp / Meta Cloud API (https://developers.facebook.com) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=cedar-threads-verify
GRAPH_API_VERSION=v21.0

# --- Orders: "csv" (default) or "sheets" ---
ORDER_BACKEND=csv
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Business rules ---
SHOP_NAME=Cedar Threads
FOLLOWUP_AFTER_HOURS=24
